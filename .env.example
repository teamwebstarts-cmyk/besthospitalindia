# --- Transactional mail (choose ONE) -------------------------------------

# Option A (recommended): Resend HTTP API
# Sign up at https://resend.com, verify wispr.hospital DNS, create an API key.
RESEND_API_KEY=re_xxxxx

# Option B: any SMTP relay (works with Resend SMTP too)
# SMTP_HOST=smtp.resend.com
# SMTP_PORT=465
# SMTP_USER=resend
# SMTP_PASS=re_xxxxx

# Sender address (must be a verified domain in Resend / your SMTP relay)
MAIL_FROM="Best Hospital India <info@wispr.hospital>"

# If none of the above are set, emails are only written to
# data/runtime/outbox.json (development/testing mode).
